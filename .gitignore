Thumbs.db
Thumbs.db:encryptable
ehthumbs_vista.ini

# Logs
logs
*.log

# MySQL
my.cnf

# SQL
*.sql

# SQLite
*.sqlite3

# Env files
.env
.env.*
!.env.example  # Uncomment if you want to track an example env file

# Poetry
# https://python-poetry.org/docs/basics/#commit-your-poetrylock-file-to-version-control
# If you want to track the lock file, comment this line out
# poetry.lock

# UV
# uv.lock is sometimes committed for reproducibility, but can be regenerated
# Comment out the next line if you want to track uv.lock
uv.lock

# Python version file - might be user-specific
.python-version

# Claude Code
.claude/